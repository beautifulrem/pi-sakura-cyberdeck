{
  "name": "pi-sakura-cyberdeck",
  "version": "1.1.6",
  "description": "Sakura Macaron visual pack for Pi: theme, cyberdeck header, matrix rain, macaron Zentui chrome, Claude-style shimmer.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-theme",
    "pi-extension",
    "tui",
    "sakura"
  ],
  "files": [
    "extensions",
    "themes",
    "licenses",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "typecheck": ".dev/node_modules/.bin/tsc -p tsconfig.json",
    "test": "node --import ./test/register.mjs --test \"test/**/*.test.ts\"",
    "verify": "npm run check && npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/header/index.ts",
      "./extensions/matrix/index.ts",
      "./extensions/zentui/index.ts",
      "./extensions/claude-shimmer/index.ts"
    ],
    "themes": [
      "./themes/sakura-macaron.json"
    ]
  }
}
