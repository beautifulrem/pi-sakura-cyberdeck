{
  "name": "pi-sakura-cyberdeck",
  "version": "1.5.2",
  "description": "Lightweight Sakura Macaron visual pack for Pi: theme, cyberdeck header, macaron Zentui chrome, Claude-style shimmer, optional matrix rain.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beautifulrem/pi-sakura-cyberdeck.git"
  },
  "homepage": "https://github.com/beautifulrem/pi-sakura-cyberdeck#readme",
  "bugs": {
    "url": "https://github.com/beautifulrem/pi-sakura-cyberdeck/issues"
  },
  "keywords": [
    "pi-package",
    "pi-theme",
    "pi-extension",
    "tui",
    "sakura",
    "pi-coding-agent",
    "theme",
    "terminal-theme",
    "pastel",
    "nerd-font"
  ],
  "files": [
    "extensions",
    "themes",
    "licenses",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "typecheck": ".dev/node_modules/.bin/tsc -p tsconfig.json",
    "test": "node --no-warnings --import ./test/register.mjs --test \"test/**/*.test.ts\"",
    "verify": "npm run check && npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "pi": {
    "extensions": [
      "./extensions/header/index.ts",
      "./extensions/matrix/index.ts",
      "./extensions/zentui/index.ts",
      "./extensions/claude-shimmer/index.ts",
      "./extensions/changelog/index.ts"
    ],
    "themes": [
      "./themes/sakura-macaron.json"
    ],
    "image": "https://raw.githubusercontent.com/beautifulrem/pi-sakura-cyberdeck/main/docs/screenshots/session.png"
  }
}
